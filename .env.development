VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT_MS=30000
VITE_AUTH_TOKEN_STORAGE=localStorage
# Set to true during development to skip the auth gate (injects a synthetic
# SUPER_ADMIN). Off by default — Phase 3 ProtectedRoute / RoleGuard apply.
VITE_AUTH_BYPASS=false
VITE_REFRESH_BEFORE_EXPIRY_S=60
VITE_UPLOAD_MAX_IMAGE_MB=10
VITE_UPLOAD_MAX_VIDEO_MB=2048
VITE_UPLOAD_CHUNK_SIZE_MB=5
VITE_ENABLE_WS_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true
VITE_APP_NAME="AzTU Portal (dev)"
VITE_APP_SHORT_NAME="AzTU"
VITE_APP_VERSION=0.1.0
