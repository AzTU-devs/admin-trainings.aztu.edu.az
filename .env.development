# admin-trainings.aztu.edu.az — LOCAL DEVELOPMENT
#
# Committed. Nothing here may be a secret: a Vite SPA inlines every VITE_* value
# into the browser bundle. Machine-specific overrides go in a gitignored .env.local.

VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT_MS=30000

# Matches production. The refresh token is not stored here at all — the API keeps
# it in an httpOnly cookie — and the access token lives in sessionStorage, so it
# is gone when the tab closes.
VITE_AUTH_TOKEN_STORAGE=sessionStorage
VITE_REFRESH_BEFORE_EXPIRY_S=60

# Set to true to skip the auth gate entirely (injects a synthetic SUPER_ADMIN).
# Off by default — ProtectedRoute / RoleGuard apply as they do in production.
VITE_AUTH_BYPASS=false

# Keep in step with the backend's UPLOAD_MAX_* and, in production, with nginx's
# client_max_body_size.
VITE_UPLOAD_MAX_IMAGE_MB=10
VITE_UPLOAD_MAX_VIDEO_MB=512
VITE_UPLOAD_MAX_DOCUMENT_MB=25

VITE_ENABLE_WS_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true

VITE_APP_NAME="AzTU Portal (dev)"
VITE_APP_SHORT_NAME="AzTU"
VITE_APP_VERSION=1.0.0
