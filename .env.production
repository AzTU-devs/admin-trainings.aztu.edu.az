# admin-trainings.aztu.edu.az — tutor / admin portal — PRODUCTION
#
# This file IS committed on purpose: a Vite SPA has no server side, so every
# VITE_* value here ends up readable in the browser bundle. Never put a secret
# in it — there is nothing to protect it. Machine-specific overrides belong in
# a gitignored .env.local.
#
# Values are inlined at BUILD time, so changing one requires a rebuild
# (`docker compose -f docker-compose.prod.yml up -d --build`), not a restart.

# Same-origin: nginx proxies /api/ to the backend on 127.0.0.1:8080, so the
# browser never makes a cross-origin call and no CORS entry is needed.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=30000

# Access token lives in memory + sessionStorage; the refresh token is held in an
# httpOnly cookie set by the API and is never readable from JavaScript.
VITE_AUTH_TOKEN_STORAGE=sessionStorage
VITE_REFRESH_BEFORE_EXPIRY_S=60

# Upload ceilings. These MUST stay in step with two other places, or uploads
# fail late with an opaque 413 instead of a clear client-side message:
#   - nginx `client_max_body_size 550m`   (nginx/nginx.conf, /api/ location)
#   - UPLOAD_MAX_* in the backend's .env  (server-side enforcement)
VITE_UPLOAD_MAX_IMAGE_MB=10
VITE_UPLOAD_MAX_VIDEO_MB=512
VITE_UPLOAD_MAX_DOCUMENT_MB=25

VITE_ENABLE_WS_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true

VITE_APP_NAME="AzTU Portal"
VITE_APP_SHORT_NAME="AzTU"
VITE_APP_VERSION=1.0.0
