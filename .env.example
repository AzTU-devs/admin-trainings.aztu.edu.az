# AzTU Portal — environment variables
# Copy to .env.development / .env.production and adjust per environment.

# API
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT_MS=30000

# Auth
VITE_AUTH_TOKEN_STORAGE=localStorage   # localStorage | sessionStorage
VITE_REFRESH_BEFORE_EXPIRY_S=60
# Dev only — bypass the auth gate and inject a synthetic SUPER_ADMIN.
VITE_AUTH_BYPASS=false

# Uploads
VITE_UPLOAD_MAX_IMAGE_MB=10
VITE_UPLOAD_MAX_VIDEO_MB=2048
VITE_UPLOAD_CHUNK_SIZE_MB=5

# Feature flags
VITE_ENABLE_WS_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true

# App
VITE_APP_NAME="AzTU Portal"
VITE_APP_SHORT_NAME="AzTU"
VITE_APP_VERSION=0.1.0
