# admin-trainings.aztu.edu.az — environment template
#
# Copy to .env.local for machine-specific overrides. .env.development and
# .env.production are the committed per-environment defaults and are the files
# an actual deploy uses.
#
# A Vite SPA has no server side: every VITE_* value below is inlined into the
# browser bundle at build time and is readable by anyone. Never put a secret here.

# --- API -------------------------------------------------------------------
# In production this is "/api" — nginx proxies it to the backend on the same
# host, so the browser makes only same-origin calls and no CORS entry is needed.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT_MS=30000

# --- Auth ------------------------------------------------------------------
# sessionStorage, not localStorage: the access token then dies with the tab
# instead of sitting readable on disk for weeks. The refresh token is never in
# web storage at all — the API sets it as an httpOnly cookie.
VITE_AUTH_TOKEN_STORAGE=sessionStorage   # sessionStorage | localStorage
VITE_REFRESH_BEFORE_EXPIRY_S=60

# Dev only — bypass the auth gate and inject a synthetic SUPER_ADMIN.
VITE_AUTH_BYPASS=false

# --- Uploads ---------------------------------------------------------------
# These are client-side pre-checks so a too-large file fails instantly with a
# clear message. The real enforcement is server-side. Three places must agree:
#   this file  ·  backend UPLOAD_MAX_*  ·  nginx client_max_body_size (550m)
VITE_UPLOAD_MAX_IMAGE_MB=10
VITE_UPLOAD_MAX_VIDEO_MB=512
VITE_UPLOAD_MAX_DOCUMENT_MB=25

# --- Feature flags ---------------------------------------------------------
VITE_ENABLE_WS_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true

# --- App -------------------------------------------------------------------
VITE_APP_NAME="AzTU Portal"
VITE_APP_SHORT_NAME="AzTU"
VITE_APP_VERSION=1.0.0
